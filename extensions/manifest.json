{
  "manifest_version": 3,
  "name": "Phishing Email Detector",
  "version": "2.0",
  "description": "Detect phishing emails with AI and show reasons",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:5000/*"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}